# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

SECRET_KEY=django-insecure-replace-me

DB_NAME=amazon
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional — leave blank to use local memory cache
REDIS_URL=

# AWS S3 — required in production for image uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=phd-media-prod
AWS_S3_REGION_NAME=us-east-1
