{% extends 'base.html' %}
{% load static %}

{% block title %}{{ SITE_NAME }} | Home Design, Construction, Coding & 3D Printing Picks{% endblock %}
{% block meta_description %}{{ SITE_TAGLINE }} Curated Amazon picks, guides, and kits for home design, construction, coding, web design, and 3D printing workflows.{% endblock %}
{% block og_title %}{{ SITE_NAME }} | Curated Tool, Gear & Setup Picks{% endblock %}
{% block og_description %}Curated Amazon picks, guides, and kits for home design, construction, coding, web design, and 3D printing workflows.{% endblock %}

{% block content %}
<section class="bg-light border-bottom py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <p class="text-uppercase text-muted small fw-semibold mb-2">Curated practical gear</p>
                <h1 class="display-6 fw-bold mb-3">Tools, tech, and setup ideas for building, designing, coding, and printing.</h1>
                <p class="lead text-muted mb-4">{{ home_hero|default:SITE_TAGLINE }}</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{% url 'guides:list' %}" class="btn btn-warning fw-semibold">Read the Guides</a>
                    <a href="{% url 'products:collection_list' %}" class="btn btn-outline-dark">Browse Kits & Collections</a>
                    <a href="{% url 'products:search' %}" class="btn btn-outline-secondary">Search All Picks</a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h2 class="h5">Start by workflow</h2>
                        <div class="list-group list-group-flush">
                            {% for cat in nav_categories %}
                            <a class="list-group-item list-group-item-action px-0" href="{{ cat.get_absolute_url }}">{{ cat.name }}</a>
                            {% empty %}
                            <span class="list-group-item px-0 text-muted small">No categories yet.</span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container py-4">

    <div class="alert alert-warning small mb-4" role="note">
        <strong>Disclosure:</strong> As an Amazon Associate I earn from qualifying purchases. This does not change the price you pay.
    </div>

    {% if featured_guides %}
    <section class="mb-5">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
            <h2 class="h4 mb-0">Featured Guides</h2>
            <a href="{% url 'guides:list' %}" class="small text-muted">View all guides <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for guide in featured_guides %}
            <div class="col">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        {% if guide.category %}<span class="badge text-bg-light border mb-2">{{ guide.category.name }}</span>{% endif %}
                        <h3 class="h5"><a href="{{ guide.get_absolute_url }}" class="text-dark text-decoration-none">{{ guide.title }}</a></h3>
                        {% if guide.dek %}<p class="text-muted small">{{ guide.dek }}</p>{% endif %}
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a href="{{ guide.get_absolute_url }}" class="btn btn-outline-dark btn-sm">Read guide</a>
                    </div>
                </article>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if featured_collections %}
    <section class="mb-5">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
            <h2 class="h4 mb-0">Kits & Collections</h2>
            <a href="{% url 'products:collection_list' %}" class="small text-muted">View all collections <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            {% for collection in featured_collections %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5"><a href="{{ collection.get_absolute_url }}" class="text-dark text-decoration-none">{{ collection.title }}</a></h3>
                        {% if collection.subtitle %}<p class="text-muted small">{{ collection.subtitle }}</p>{% endif %}
                        <p class="small mb-0">{{ collection.products.count }} picks</p>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a href="{{ collection.get_absolute_url }}" class="btn btn-outline-dark btn-sm">Open collection</a>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if popular_tags %}
    <section class="mb-5">
        <h2 class="h5 mb-3">Browse by use case</h2>
        <div class="d-flex flex-wrap gap-2">
            {% for tag in popular_tags %}
            <a href="{% url 'products:search' %}?tag={{ tag.slug }}" class="btn btn-sm btn-outline-secondary rounded-pill">{{ tag.name }}</a>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if featured_products %}
    <section class="mb-5">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
            <h2 class="h4 mb-0">Featured Picks</h2>
            <span class="small text-muted">Useful gear worth highlighting first</span>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            {% for product in featured_products %}
                {% include 'partials/product_card.html' %}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% for section in sections %}
    <section class="mb-5">
        <div class="d-flex align-items-baseline justify-content-between mb-3">
            <h2 class="h4 mb-0">{{ section.name }}</h2>
            <a href="{{ section.get_absolute_url }}" class="small text-muted">
                View all <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            {% for product in section.active_products|slice:":4" %}
                {% include 'partials/product_card.html' %}
            {% endfor %}
        </div>
    </section>
    {% endfor %}

    {% if uncategorized %}
    <section class="mb-5">
        <h2 class="h4 mb-3">Other Picks</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            {% for product in uncategorized %}
                {% include 'partials/product_card.html' %}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if not sections and not uncategorized and not featured_products %}
    <p class="text-center text-muted py-5">No products yet. Check back soon.</p>
    {% endif %}

</div>
{% endblock %}
